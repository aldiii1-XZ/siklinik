{
  "name": "siklinik",
  "private": true,
  "version": "1.0.0",
  "description": "SIKLINIK — Sistem Informasi Antrean Klinik Kampus. Ambil nomor antrean, pantau giliran, kelola layanan klinik.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:server": "npm --prefix server test",
    "test:all": "npm test && npm run test:server",
    "test:e2e": "node tests/e2e/verify.cjs",
    "test:vercel": "node tests/vercel-fn.test.mjs",
    "server": "npm --prefix server start",
    "install:all": "npm install && npm --prefix server install",
    "start": "npm --prefix server start"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
