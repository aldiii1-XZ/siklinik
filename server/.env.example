# Contoh konfigurasi server SIKLINIK.
# Salin jadi `.env` lalu sesuaikan bila perlu: cp .env.example .env

# Port server API (default 3000)
PORT=3000

# Lokasi berkas basis data SQLite (default: server/data/siklinik.db)
# DB_PATH=./data/siklinik.db

# ── Asisten kesehatan (opsional) ──────────────────────────────────────────
# Kosongkan untuk memakai MODE LOKAL: asisten menjawab dari basis
# pengetahuan bawaan, tanpa perlu internet atau API key. Aplikasi tetap
# berfungsi penuh.
#
# Isi ketiganya untuk memakai LLM (mis. lewat 9Router, OpenRouter, OpenAI,
# atau endpoint apa pun yang kompatibel dengan OpenAI). Kunci TIDAK boleh
# ditulis di kode — cukup di berkas .env ini (sudah diabaikan Git).
#
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# AI_BASE_URL=https://api.9router.com/v1
# AI_MODEL=nama-model-yang-kamu-pakai
#
# Batas waktu permintaan ke LLM dalam milidetik (default 30000)
# AI_TIMEOUT_MS=30000
